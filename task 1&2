import pandas as pd
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import accuracy_score
from sklearn.metrics import confusion_matrix

train_data = pd.read_csv("final_fitted_purchase_again_data.csv")
test_data = pd.read_csv("final_fitted_purchase_again_data_eval.csv")

'''
